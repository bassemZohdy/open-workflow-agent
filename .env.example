# Copy this file to `.env` for local Docker Compose usage:
#   cp .env.example .env
#
# `.env` is ignored by git. Keep real credentials only in the local `.env`
# file or, for production, in your deployment secret manager.

POSTGRES_IMAGE=postgres:16
POSTGRES_USER=owa
POSTGRES_PASSWORD=owa-local-only
POSTGRES_DB=owa
POSTGRES_PORT=5432

ADK_PORT=8080
LANGGRAPH_PORT=8081
ADK_IMAGE=owa-adk:local
LANGGRAPH_IMAGE=owa-langgraph:local

OWA_VERSION=0.1.0
VCS_REF=local

# -----------------------------------------------------------------------------
# Model provider selection
# -----------------------------------------------------------------------------
# `fake` is deterministic and requires no network/API key.
MODEL_PROVIDER=fake
MODEL_NAME=fake/default

# For every real model provider, use:
#   MODEL_PROVIDER=litellm
# and set MODEL_NAME to the LiteLLM model identifier.
#
# The repository Compose file passes this `.env` into the runtime container so
# LiteLLM can read provider-specific credential variables. Populate only the
# provider credentials you actually use.

# OpenAI
#   MODEL_PROVIDER=litellm
#   MODEL_NAME=openai/<model-name>
# Example current LiteLLM syntax: openai/gpt-5
OPENAI_API_KEY=

# Anthropic
#   MODEL_PROVIDER=litellm
#   MODEL_NAME=anthropic/<model-name>
# Example syntax: anthropic/claude-<model-name>
ANTHROPIC_API_KEY=

# OpenRouter
#   MODEL_PROVIDER=litellm
#   MODEL_NAME=openrouter/<provider>/<model-name>
OPENROUTER_API_KEY=

# Ollama running on the Docker host
#   MODEL_PROVIDER=litellm
#   MODEL_NAME=ollama/<local-model-name>
#   OWA__MODEL__OPTIONS__API_BASE=http://host.docker.internal:11434
# Ollama normally requires no API key. `compose.yaml` maps
# host.docker.internal to the Docker host for local development.

# Any other LiteLLM provider
#   MODEL_PROVIDER=litellm
#   MODEL_NAME=<litellm-provider-prefix>/<model-name>
#
# Add the provider-specific environment variables required by LiteLLM directly
# to this `.env`; Compose passes them through to the runtime container.
# For OpenAI-compatible/custom endpoints you can also use the generic runtime
# options below. Uncomment only what you need:
#
# OWA__MODEL__OPTIONS__API_KEY=replace-me
# OWA__MODEL__OPTIONS__API_BASE=https://provider.example/v1
# OWA__MODEL__OPTIONS__API_VERSION=replace-me
#
# Provider/model prefixes and required variables are documented by LiteLLM:
# https://docs.litellm.ai/

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# compose.yaml injects OWA__PERSISTENCE__DATASOURCE into the runtime containers,
# pointing them at the PostgreSQL service above:
#   postgresql://owa:<password>@postgres:5432/owa
# Do not set OWA__PERSISTENCE__DATASOURCE here unless you intend to override
# that. To run Compose without PostgreSQL persistence, remove the datasource
# environment from compose.yaml (or override it here with an empty value) and
# the runtime falls back to its SQLite default under /data.

# -----------------------------------------------------------------------------
# Inbound A2A (optional, disabled by default)
# -----------------------------------------------------------------------------
# Exposes the runtime as an A2A agent: Agent Card plus a synchronous
# message/send endpoint. Only enable behind an edge that provides
# authentication and rate limiting.
#
# OWA__A2A__ENABLED=true
# OWA__A2A__TRANSPORT=jsonrpc
# OWA__A2A__PUBLIC_BASE_URL=https://agents.example.com
# Bearer authentication references a named 'bearer' security profile defined in
# the security.profiles configuration section (the profile token itself resolves
# from an environment variable, e.g. A2A_PARTNER_TOKEN).
# OWA__A2A__SECURITY_PROFILE=partner-agent

# -----------------------------------------------------------------------------
# Durable approvals (optional, disabled by default)
# -----------------------------------------------------------------------------
# Operator authorization resolves a named bearer security profile:
#
# OWA__SECURITY__PROFILES__OPERATOR__TYPE=bearer
# OWA__SECURITY__PROFILES__OPERATOR__TOKEN__FROM_ENV=OWA_OPERATOR_TOKEN
# OWA__APPROVALS__ENABLED=true
# OWA__APPROVALS__OPERATOR_SECURITY_PROFILE=operator
# OWA_OPERATOR_TOKEN=replace-me
