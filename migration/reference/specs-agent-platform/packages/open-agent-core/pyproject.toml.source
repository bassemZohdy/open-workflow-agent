[project]
name = "open-agent-core"
version = "0.1.0"
description = "Validation, binding, and framework-neutral IR for Specs Agent Platform"
requires-python = ">=3.11,<3.14"
dependencies = [
  "fastapi>=0.115,<1",
  "httpx>=0.27,<1",
  "jsonschema>=4.23,<5",
  "mcp>=1,<2",
  "opentelemetry-api>=1.28,<2",
  "opentelemetry-exporter-otlp>=1.28,<2",
  "asyncpg>=0.29,<1",
  "opentelemetry-instrumentation-fastapi>=0.49b0,<1",
  "opentelemetry-instrumentation-httpx>=0.49b0,<1",
  "opentelemetry-sdk>=1.28,<2",
  "pydantic>=2.9,<3",
  "pyagentspec>=26.1,<27",
  "pyyaml>=6.0,<7",
]

[project.scripts]
open-agent-core = "open_agent_core.cli:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
