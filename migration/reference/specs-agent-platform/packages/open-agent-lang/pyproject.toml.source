[project]
name = "open-agent-lang"
version = "0.1.0"
description = "LangGraph adapter for Specs Agent Platform"
requires-python = ">=3.11,<3.14"
dependencies = [
  "langchain-core>=1.2.22,<2",
  "langchain-openai>=1,<2",
  "langgraph>=1,<2",
  "mcp>=1,<2",
  "open-agent-core",
  "fastapi>=0.115,<1",
  "uvicorn[standard]>=0.32,<1",
]

[tool.uv.sources]
open-agent-core = { workspace = true }

[project.scripts]
open-agent-lang = "open_agent_lang.cli:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
