FROM python:3.11-slim
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev --package open-agent-lang \
    && python -m pip uninstall --yes uv setuptools wheel pip \
    && rm -rf /root/.cache/uv
RUN mkdir -p /data && chown -R 10001:10001 /data
ENV HOME=/tmp
USER 10001
CMD ["/app/.venv/bin/open-agent-lang", "serve", "/app/examples/application", "--host", "0.0.0.0"]
