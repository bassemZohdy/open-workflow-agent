<svg xmlns="http://www.w3.org/2000/svg" width="1120" height="520" viewBox="0 0 1120 520" role="img" aria-labelledby="title description">
  <title id="title">Specs Agent Platform architecture</title>
  <desc id="description">Open Workflow and Open Agent Specification documents flow through separate core loaders into a shared intermediate representation, then into either the LangGraph or Google ADK engine and their shared API surface. As of this diagram, LangGraph compiles a linear node chain and Google ADK compiles agent-level LlmAgent objects only; both still delegate workflow task-tree interpretation to the shared InMemoryEngine rather than native framework constructs. See TODO.md's native framework compilation tasks for the planned replacement.</desc>
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#475569"/>
    </marker>
    <style>
      .title { font: 700 24px system-ui, sans-serif; fill: #0f172a; }
      .group { font: 700 15px system-ui, sans-serif; fill: #334155; }
      .label { font: 600 15px system-ui, sans-serif; fill: #0f172a; }
      .small { font: 13px system-ui, sans-serif; fill: #475569; }
      .flow { stroke: #475569; stroke-width: 2; fill: none; marker-end: url(#arrow); }
      .input { fill: #eff6ff; stroke: #2563eb; stroke-width: 2; }
      .core { fill: #f0fdf4; stroke: #16a34a; stroke-width: 2; }
      .engine { fill: #fff7ed; stroke: #ea580c; stroke-width: 2; }
      .surface { fill: #faf5ff; stroke: #9333ea; stroke-width: 2; }
    </style>
  </defs>
  <rect width="1120" height="520" rx="16" fill="#f8fafc"/>
  <text x="40" y="45" class="title">Specs Agent Platform</text>

  <text x="40" y="90" class="group">Declarative inputs</text>
  <rect x="40" y="110" width="210" height="90" rx="10" class="input"/>
  <text x="145" y="145" text-anchor="middle" class="label">Open Workflow</text>
  <text x="145" y="170" text-anchor="middle" class="small">YAML / JSON</text>
  <rect x="40" y="250" width="210" height="90" rx="10" class="input"/>
  <text x="145" y="285" text-anchor="middle" class="label">Open Agent Spec</text>
  <text x="145" y="310" text-anchor="middle" class="small">YAML / JSON</text>

  <text x="330" y="90" class="group">Shared core</text>
  <rect x="330" y="110" width="220" height="90" rx="10" class="core"/>
  <text x="440" y="145" text-anchor="middle" class="label">Workflow loader</text>
  <text x="440" y="170" text-anchor="middle" class="small">Validate and normalize</text>
  <rect x="330" y="250" width="220" height="90" rx="10" class="core"/>
  <text x="440" y="285" text-anchor="middle" class="label">Agent Spec loader</text>
  <text x="440" y="310" text-anchor="middle" class="small">Validate and normalize</text>
  <rect x="620" y="180" width="210" height="90" rx="10" class="core"/>
  <text x="725" y="215" text-anchor="middle" class="label">ApplicationIR</text>
  <text x="725" y="240" text-anchor="middle" class="small">Workflows, agents, bindings</text>

  <text x="890" y="90" class="group">Alternative engines</text>
  <rect x="890" y="110" width="190" height="90" rx="10" class="engine"/>
  <text x="985" y="145" text-anchor="middle" class="label">LangGraph</text>
  <text x="985" y="170" text-anchor="middle" class="small">Linear StateGraph + runner</text>
  <rect x="890" y="250" width="190" height="90" rx="10" class="engine"/>
  <text x="985" y="285" text-anchor="middle" class="label">Google ADK</text>
  <text x="985" y="310" text-anchor="middle" class="small">LlmAgent only + runner</text>

  <rect x="620" y="400" width="460" height="75" rx="10" class="surface"/>
  <text x="850" y="430" text-anchor="middle" class="label">Shared deployment surface</text>
  <text x="850" y="455" text-anchor="middle" class="small">OpenAI-compatible API · CloudEvents · health · engine UI</text>

  <path d="M250 155 H330" class="flow"/>
  <path d="M250 295 H330" class="flow"/>
  <path d="M550 155 L620 205" class="flow"/>
  <path d="M550 295 L620 245" class="flow"/>
  <path d="M830 205 L890 160" class="flow"/>
  <path d="M830 245 L890 290" class="flow"/>
  <path d="M985 200 V390 H850 V400" class="flow"/>
  <path d="M985 340 V375 H850 V400" class="flow"/>
</svg>
