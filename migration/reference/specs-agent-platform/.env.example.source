# Copy to .env for local overrides, or pass directly with
# `docker compose --env-file .env.example ...`.

COMPOSE_PROJECT_NAME=specs-agent-platform
POSTGRES_DB=specs_agent
POSTGRES_USER=specs_agent
POSTGRES_PASSWORD=change-me

APPLICATION_PATH=/app/examples/application
WORKFLOW_SPEC_PATH=
AGENT_SPEC_PATH=
LANG_PORT=8081
ADK_PORT=8082
LANG_CONTAINER_PORT=8080
ADK_CONTAINER_PORT=8080

# Supply credentials only for the engine you run.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_API_KEY=
SPECS_AGENT_API_KEY=

# Default model used for any agent/sub-agent that omits llm_config.model_id.
# Precedence: agent's own declared model > engine-specific default below >
# DEFAULT_MODEL > built-in fallback (gpt-4o-mini / gemini-2.0-flash). Not yet
# implemented; see MODEL-001..MODEL-005 in TODO.md.
# DEFAULT_MODEL=
# OPENAI_DEFAULT_MODEL=
# GOOGLE_DEFAULT_MODEL=
REQUEST_TIMEOUT_SECONDS=120
MAX_REQUEST_BYTES=1048576
CORS_ALLOW_ORIGINS=
CHECKPOINT_DB_PATH=
# CHECKPOINT_DATABASE_URL=postgresql://specs_agent:change-me@postgres:5432/specs_agent
# DATABASE_URL=postgresql://specs_agent:change-me@postgres:5432/specs_agent

# Checkpoint retention. Set CHECKPOINT_RETENTION_INTERVAL_SECONDS to 0 to disable
# background expiry.
CHECKPOINT_RETENTION_MAX_AGE_SECONDS=0
CHECKPOINT_RETENTION_MAX_COUNT_PER_ENTRYPOINT=0
CHECKPOINT_RETENTION_KEEP_STATUSES=
CHECKPOINT_RETENTION_INTERVAL_SECONDS=0
SHUTDOWN_GRACE_PERIOD_SECONDS=30
MCP_DISCOVERY_TTL_SECONDS=60

# Rate limiting and authentication lockout. Set to 0 to disable.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOCKOUT_MAX_FAILURES=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=300

# MCP sandboxing and lifecycle controls.
MCP_ALLOWED_COMMANDS=
MCP_DENIED_COMMANDS=sh,bash,zsh,cmd,powershell,pwsh,fish,csh
MCP_ALLOW_SHELL=0
MCP_ALLOWED_ENV_VARS=
MCP_DENIED_ENV_VARS=
MCP_ALLOWED_CWD_ROOT=
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_DISCOVERY_TIMEOUT_SECONDS=5
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_CONCURRENT_SESSIONS=10

# ADK native Web UI/session defaults.
ADK_NATIVE_UI=1
ADK_SESSION_SERVICE_URI=memory://
ADK_ARTIFACT_SERVICE_URI=memory://
ADK_MEMORY_SERVICE_URI=memory://
ADK_FALLBACK_ON_ERROR=1
