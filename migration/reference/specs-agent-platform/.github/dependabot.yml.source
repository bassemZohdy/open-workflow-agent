version: 2
updates:
  - package-ecosystem: "uv"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      python-dependencies:
        patterns:
          - "*"

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"

  - package-ecosystem: "docker"
    directory: "/packages/open-agent-lang"
    schedule:
      interval: "weekly"

  - package-ecosystem: "docker"
    directory: "/packages/open-agent-adk"
    schedule:
      interval: "weekly"
