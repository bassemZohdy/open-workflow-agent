name: CI

on:
  push:
    branches:
      - main
  pull_request:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  quality:
    uses: ./.github/workflows/_quality.yml
    permissions:
      contents: read
    with:
      ref: ${{ github.sha }}

  arm64-dry-run:
    name: ARM64 image dry-run build
    needs: quality
    runs-on: [self-hosted, linux, x64, specs-agent]
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        include:
          - name: LangGraph
            dockerfile: packages/open-agent-lang/Dockerfile
          - name: ADK
            dockerfile: packages/open-agent-adk/Dockerfile
    steps:
      - name: Check out source
        uses: actions/checkout@v6
        with:
          ref: ${{ github.sha }}

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Build ${{ matrix.name }} image for linux/arm64
        uses: docker/build-push-action@v7
        with:
          context: .
          file: ${{ matrix.dockerfile }}
          platforms: linux/arm64
          push: false
