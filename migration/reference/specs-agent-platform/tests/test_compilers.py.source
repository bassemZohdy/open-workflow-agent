def test_langgraph_native_listen_matches_interpreter() -> None:
    """COMPILE-007: listen node matching and failure match the interpreter."""
    workflow_path = CONFORMANCE / "listen.yaml"
    application = load_application(root=CONFORMANCE, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)

    # Matching event.
    payload = {"events": [{"type": "order.created"}, {"type": "other"}]}
    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-listen-hit"}))
    assert _engine_output(result) == expected
    assert result["output"] == [{"type": "order.created"}]

    # No matching event: both engines raise.
    with pytest.raises(RuntimeError, match="no matching event"):
        asyncio.run(
            InMemoryEngine(application).invoke(workflow.id, {"events": [{"type": "other"}]})
        )
    with pytest.raises(RuntimeError, match="no matching event"):
        asyncio.run(
            graph.ainvoke(
                {"payload": {"events": [{"type": "other"}]}, "run_id": "parity-listen-miss"}
            )
        )


