    assert response.json()["object"] == "model"

    unknown = client.get("/v1/models/unknown/model@1")
    assert unknown.status_code == 404


def test_adk_models_pagination() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_adk_app(application=application))

    response = client.get("/v1/models?limit=1")
    assert response.status_code == 200
    body = response.json()
    assert len(body["data"]) == 1
    assert body["has_more"] is True
    assert body["last_id"] is not None


