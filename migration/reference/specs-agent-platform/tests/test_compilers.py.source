import asyncio
from pathlib import Path
from typing import Any

import pytest
from fastapi.testclient import TestClient
from open_agent_adk import compile_agent
from open_agent_adk.runner import create_app as create_adk_app
from open_agent_core import BindingsIR, InMemoryEngine, SQLiteCheckpointStore, load_application
from open_agent_lang import compile_workflow
from open_agent_lang.compiler import LangGraphCompiler

ROOT = Path(__file__).parents[1]
CONFORMANCE = ROOT / "tests" / "fixtures" / "conformance" / "workflows"

# Fixtures whose tasks are all COMPILE-002 kinds (set/call/run) must produce
# identical output through the compiled graph and the interpreter.
NATIVE_PARITY_FIXTURES = [
    "minimal.yaml",
    "run.yaml",
    "set-and-call.yaml",
]


def _engine_output(result: Any) -> Any:
    """Normalize an engine result to the interpreter's output envelope.

    The interpreter wraps non-dict output in ``{"output": ...}``; the compiled
    graph carries the raw output value. Both engines normalize identically at
    their invoke boundary, so parity comparisons go through this helper.
    """
    if isinstance(result, dict) and "output" in result:
        output = result["output"]
        return output if isinstance(output, dict) else {"output": output}
    return result


def test_langgraph_compiler_builds_and_runs_async_graph() -> None:
    application = load_application(ROOT / "examples" / "application")
    graph = compile_workflow(application)

    result = asyncio.run(
        graph.ainvoke(
            {
                "payload": {"request": "hello"},
                "messages": [{"role": "user", "content": "hello"}],
            }
        )
    )

    assert result["output"]["content"].startswith("support-agent:")


@pytest.mark.parametrize(
    "fixture",
    NATIVE_PARITY_FIXTURES,
)
def test_langgraph_native_set_call_run_matches_interpreter(fixture: str) -> None:
    """COMPILE-002: native set/call/run nodes match the interpreter output."""
    application = load_application(root=CONFORMANCE, workflow_path=CONFORMANCE / fixture)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"message": "hello"}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-set-call-run"}))

    assert result.get("output", {}) == expected


def test_langgraph_native_call_dispatch_matches_interpreter() -> None:
    """COMPILE-002: bound-agent and handler call dispatch stay in parity."""
    application = load_application(ROOT / "examples" / "application")
    graph = compile_workflow(application, application.workflows[0].id)
    payload = {"request": "hello"}

    expected = asyncio.run(InMemoryEngine(application).invoke(application.workflows[0].id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-call"}))

    assert result["output"] == expected
    assert result["output"]["content"].startswith("support-agent:")


def test_langgraph_native_nodes_honor_if_gate() -> None:
    """COMPILE-002: the ``if`` condition on native kinds mirrors the interpreter."""
    workflow_path = ROOT / "tests" / "fixtures" / "conformance" / "workflows" / "set-and-call.yaml"
    application = load_application(root=workflow_path.parent, workflow_path=workflow_path)
    # Rebuild the workflow with an if-gated set task.
    workflow = application.workflows[0]

    gated = workflow.model_copy(
        update={
            "tasks": (
                workflow.tasks[0].model_copy(
                    update={"config": {"if": "false", "set": {"status": "never"}}}
                ),
            )
        }
    )
    gated_app = application.model_copy(update={"workflows": (gated,)})
    graph = compile_workflow(gated_app, gated.id)
    payload = {"message": "hello"}

    expected = asyncio.run(InMemoryEngine(gated_app).invoke(gated.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-if"}))

    assert result["output"] == expected


@pytest.mark.parametrize("mode", ["fast", "slow", "unknown"])
def test_langgraph_native_switch_matches_interpreter(mode: str) -> None:
    """COMPILE-003: case/default/no-match switch routing matches the interpreter."""
    workflow_path = CONFORMANCE / "switch-default.yaml"
    application = load_application(root=CONFORMANCE, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"mode": mode}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": f"parity-switch-{mode}"}))

    assert result["output"] == expected
    if mode == "fast":
        assert result["output"]["strategy"] == "fast"
    else:
        assert result["output"]["strategy"] == "default"


def test_langgraph_native_switch_when_branches_match_interpreter(tmp_path: Path) -> None:
    """COMPILE-003: when-expression branches (no case) match the interpreter."""
    workflow_path = tmp_path / "switch-when.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: switch-when
  version: '1.0.0'
do:
  - route:
      switch:
        - when: '${ .priority == "high" }'
          then:
            - set_high:
                set:
                  tier: high
        - name: fallback
          default: true
          then:
            - set_low:
                set:
                  tier: low
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)

    for priority in ("high", "low"):
        payload = {"priority": priority}
        expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
        result = asyncio.run(
            graph.ainvoke({"payload": payload, "run_id": f"parity-switch-when-{priority}"})
        )
        assert result["output"] == expected
        assert result["output"]["tier"] == ("high" if priority == "high" else "low")


def test_langgraph_native_switch_if_gate_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-003: an if-gated switch skips branch execution like the interpreter."""
    workflow_path = tmp_path / "switch-gated.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: switch-gated
  version: '1.0.0'
do:
  - branch:
      if: false
      case: '${ .mode }'
      switch:
        - name: fast
          then:
            - set_fast:
                set:
                  strategy: fast
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"mode": "fast"}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-switch-gated"}))

    assert result["output"] == expected
    assert "strategy" not in result["output"]


@pytest.mark.parametrize("compete", [False, True])
def test_langgraph_native_fork_join_matches_interpreter(compete: bool) -> None:
    """COMPILE-004: parallel fork branches merge deterministically."""
    workflow_path = CONFORMANCE / "fork-join.yaml"
    application = load_application(root=CONFORMANCE, workflow_path=workflow_path)
    workflow = application.workflows[0]
    if compete:
        task = workflow.tasks[0].model_copy(
            update={"config": {"fork": {"branches": [], "compete": True}}}
        )
        workflow = workflow.model_copy(update={"tasks": (task,)})
        application = application.model_copy(update={"workflows": (workflow,)})
    graph = compile_workflow(application, workflow.id)
    payload = {"message": "hello"}

    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": f"parity-fork-{compete}"}))

    if not compete:
        expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
        assert _engine_output(result) == expected
        branches = result["output"]
        assert branches[0]["left"] is True
        assert branches[1]["right"] is True
    else:
        # Compete resolves deterministically to the first declared branch;
        # the interpreter's first-completed order is nondeterministic here,
        # so only the compiled graph's determinism is asserted.
        assert result["output"] == {"left": True}


@pytest.mark.parametrize("items", [[1, 2, 3], [], ["a"]])
def test_langgraph_native_for_loop_matches_interpreter(items: list[Any]) -> None:
    """COMPILE-005: for-in loops match the interpreter, incl. empty iterables."""
    workflow_path = CONFORMANCE / "for-in.yaml"
    application = load_application(root=CONFORMANCE, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"items": items}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": f"parity-for-{len(items)}"}))

    assert _engine_output(result) == expected
    if items:
        assert result["output"]["last"] == items[-1]
    else:
        # Empty iterable: the body never runs, so no values are written.
        assert result["output"] == {}
    # Loop variables are scoped: item/index are restored after the loop.
    assert "item" not in result["values"]
    assert "index" not in result["values"]


def test_langgraph_native_for_while_break_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-005: a task-level while condition breaks the loop like the interpreter."""
    workflow_path = tmp_path / "for-while.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: for-while
  version: '1.0.0'
do:
  - seed:
      set:
        counter: 0
  - iterate:
      for:
        in: '${ .items }'
        as: item
      while: '${ context.counter < 3 }'
      do:
        - remember:
            set:
              counter: '${ .item }'
              last: '${ .item }'
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"items": [1, 2, 3, 4], "counter": 0}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-for-while"}))

    assert _engine_output(result) == expected
    # Body ran for items 1..3; the while condition stopped before item 4.
    assert result["output"]["last"] == 3


def test_langgraph_native_nested_loop_scoping_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-005: SPEC-002 scoped shadowing in nested loops matches the interpreter."""
    workflow_path = tmp_path / "nested-loops.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: integration
  name: nested
  version: '1.0.0'
do:
  - outer:
      for:
        in: [1, 2]
        each: item
      do:
        - inner:
            for:
              in: [10, 20]
              each: item
            do:
              - collect:
                  set:
                    result: '${ context.item }'
        - after_inner:
            set:
              outer_item: '${ context.item }'
""",
        encoding="utf-8",
    )
    application = load_application(workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload: dict[str, Any] = {}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-nested-loops"}))

    assert _engine_output(result) == expected
    assert result["output"]["outer_item"] == 2


def test_langgraph_native_loop_max_iteration_guard(tmp_path: Path) -> None:
    """COMPILE-005: the configurable max-iteration guard stops runaway loops."""
    workflow_path = tmp_path / "runaway.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: runaway
  version: '1.0.0'
do:
  - iterate:
      for:
        in: '${ .items }'
        as: item
      do:
        - keep:
            set:
              tick: '${ .item }'
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    compiler = LangGraphCompiler(application)
    compiler.max_loop_iterations = 5
    graph = compiler.compile(application.workflows[0].id)

    with pytest.raises(RuntimeError, match="exceeded the maximum of 5 iterations"):
        asyncio.run(
            graph.ainvoke({"payload": {"items": list(range(100))}, "run_id": "parity-runaway"})
        )


def test_langgraph_delegated_while_task_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-005: task-level while (kind do) stays interpreter-parity (no loop)."""
    workflow_path = CONFORMANCE / "while.yaml"
    application = load_application(root=CONFORMANCE, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"counter": 0}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-while"}))

    # The loader normalizes a bare while+do task to kind ``do``, which the
    # interpreter runs once; the compiled graph delegates it identically.
    assert _engine_output(result) == expected


async def _flaky_handler(arguments: Any) -> Any:
    """A call handler that always fails; used by retry/catch fixtures."""
    raise RuntimeError(f"flaky failure: {arguments}")


def _controlled_application(tmp_path: Path, body: str) -> Any:
    workflow_path = tmp_path / "controlled.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: controlled
  version: '1.0.0'
do:
"""
        + body,
        encoding="utf-8",
    )
    return load_application(root=tmp_path, workflow_path=workflow_path)


def _graph_with_handlers(application: Any, workflow_id: str, handlers: dict[str, Any]) -> Any:
    """Compile with call handlers injected through the interpreter runtime,
    matching how LangGraphEngine wires its fallback runtime."""
    runtime = InMemoryEngine(application, call_handlers=handlers)
    return LangGraphCompiler(application, runtime=runtime).compile(workflow_id)


def test_langgraph_native_retry_matches_interpreter() -> None:
    """COMPILE-006: static retry maps to LangGraph's RetryPolicy."""
    workflow_path = CONFORMANCE / "retry-constant.yaml"
    application = load_application(root=CONFORMANCE, workflow_path=workflow_path)
    workflow = application.workflows[0]
    payload: dict[str, Any] = {}

    calls: list[int] = []

    async def counting_flaky(_: Any) -> Any:
        calls.append(1)
        raise RuntimeError("flaky")

    with pytest.raises(RuntimeError, match="flaky"):
        asyncio.run(
            InMemoryEngine(application, call_handlers={"flaky": counting_flaky}).invoke(
                workflow.id, payload
            )
        )
    interpreter_calls = len(calls)
    calls.clear()
    with pytest.raises(RuntimeError, match="flaky"):
        asyncio.run(
            _graph_with_handlers(application, workflow.id, {"flaky": counting_flaky}).ainvoke(
                {"payload": payload, "run_id": "parity-retry"}
            )
        )

    # max_attempts: 3 means three flaky calls before failing, in both engines.
    assert len(calls) == interpreter_calls == 3


def test_langgraph_native_catch_filter_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-006: catch error filtering and aliasing match the interpreter."""
    application = _controlled_application(
        tmp_path,
        """  - risky:
      call: flaky
      catch:
        errors:
          with:
            type: RuntimeError
        as: caught
        do:
          - recover:
              set:
                recovered: '${ .caught.message }'
""",
    )
    workflow = application.workflows[0]
    graph = _graph_with_handlers(application, workflow.id, {"flaky": _flaky_handler})
    payload: dict[str, Any] = {}

    expected = asyncio.run(
        InMemoryEngine(application, call_handlers={"flaky": _flaky_handler}).invoke(
            workflow.id, payload
        )
    )
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-catch-filter"}))

    assert _engine_output(result) == expected
    assert result["output"]["recovered"] == "flaky failure: {}"


def test_langgraph_native_catch_filter_rejects_mismatch(tmp_path: Path) -> None:
    """COMPILE-006: a non-matching catch filter propagates the failure."""
    application = _controlled_application(
        tmp_path,
        """  - risky:
      call: flaky
      catch:
        errors:
          with:
            type: ValueError
        as: caught
        do:
          - recover:
              set:
                recovered: true
""",
    )
    workflow = application.workflows[0]
    graph = _graph_with_handlers(application, workflow.id, {"flaky": _flaky_handler})
    payload: dict[str, Any] = {}

    with pytest.raises(RuntimeError, match="flaky failure"):
        asyncio.run(
            InMemoryEngine(application, call_handlers={"flaky": _flaky_handler}).invoke(
                workflow.id, payload
            )
        )
    with pytest.raises(RuntimeError, match="flaky failure"):
        asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-catch-reject"}))


def test_langgraph_native_finally_runs_on_success_and_error(tmp_path: Path) -> None:
    """COMPILE-006: finally runs on success, handled, and unhandled paths."""
    cleanup_calls: list[int] = []

    async def cleanup(_: Any) -> Any:
        cleanup_calls.append(1)
        return {"cleanup": True}

    application = _controlled_application(
        tmp_path,
        """  - risky:
      call: flaky
      catch:
        do:
          - recover:
              set:
                recovered: true
      finally:
        do:
          - cleanup:
              call: cleanup-handler
""",
    )
    workflow = application.workflows[0]
    handlers = {"flaky": _flaky_handler, "cleanup-handler": cleanup}
    payload: dict[str, Any] = {}

    # Handled failure: recover + finally run.
    graph = _graph_with_handlers(application, workflow.id, handlers)
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-finally-handled"}))
    # The finally chain's call writes the final output; the recovered value
    # lives in the accumulated values, matching the interpreter's output.
    assert result["values"]["recovered"] is True
    assert result["output"] == {"cleanup": True}
    assert len(cleanup_calls) == 1

    # Unhandled failure (no catch): finally still runs, then the error propagates.
    cleanup_calls.clear()
    application_no_catch = _controlled_application(
        tmp_path,
        """  - risky:
      call: flaky
      finally:
        do:
          - cleanup:
              call: cleanup-handler
""",
    )
    workflow_no_catch = application_no_catch.workflows[0]
    graph_no_catch = _graph_with_handlers(application_no_catch, workflow_no_catch.id, handlers)
    with pytest.raises(RuntimeError, match="flaky failure"):
        asyncio.run(
            graph_no_catch.ainvoke({"payload": payload, "run_id": "parity-finally-unhandled"})
        )
    assert len(cleanup_calls) == 1

    # Success path: finally runs once after the task.
    cleanup_calls.clear()
    application_ok = _controlled_application(
        tmp_path,
        """  - risky:
      call: cleanup-handler
      finally:
        do:
          - cleanup:
              call: cleanup-handler
""",
    )
    workflow_ok = application_ok.workflows[0]
    graph_ok = _graph_with_handlers(application_ok, workflow_ok.id, handlers)
    asyncio.run(graph_ok.ainvoke({"payload": payload, "run_id": "parity-finally-ok"}))
    # The task itself calls cleanup-handler once, and the finally chain once.
    assert len(cleanup_calls) == 2


@pytest.mark.parametrize(
    "fixture",
    ["wait.yaml", "emit.yaml", "run.yaml"],
