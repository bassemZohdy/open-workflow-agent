    client = TestClient(create_adk_app(application=application))

    response = client.get("/v1/tools", headers={"Origin": "https://example.com"})

    assert "access-control-allow-origin" not in response.headers


def test_adk_tools_capability_route() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_adk_app(application=application))

    response = client.get("/v1/tools")

    assert response.status_code == 200
    body = response.json()
    assert body["object"] == "list"
    assert body["data"] == []
    assert body["has_more"] is False


def test_adk_compiler_adapts_declared_mcp_tool() -> None:
    application = load_application(ROOT / "examples" / "application")
    application = application.model_copy(
        update={
            "bindings": BindingsIR(
                tool_bindings={
                    "lookup": {
                        "transport": "stdio",
                        "command": "example-mcp",
                        "tool": "lookup_order",
                    }
                }
            ),
            "agents": (
                application.agents[0].model_copy(
                    update={
                        "tools": (
                            {
                                "name": "lookup",
                                "binding": "lookup",
                                "description": "Look up an order.",
                                "parameters": {
                                    "type": "object",
                                    "properties": {"order_id": {"type": "string"}},
                                    "required": ["order_id"],
                                },
                            },
                        )
                    }
                ),
            ),
        }
    )

    compiled = compile_agent(application)

    assert len(compiled.tools) == 1
    assert compiled.tools[0].name == "lookup"
    assert compiled.tools[0]._get_declaration().name == "lookup"


def test_adk_get_model_by_id() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_adk_app(application=application))

    response = client.get("/v1/models/example.support/support-workflow@1.0.0")
