def test_langgraph_native_raise_with_catch_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-007: a raise inside a catch block recovers like the interpreter."""
    application = _controlled_application(
        tmp_path,
        """  - risky:
      raise: boom
      catch:
        do:
          - recover:
              set:
                recovered: true
""",
    )
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload: dict[str, Any] = {}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-raise-catch"}))

    assert _engine_output(result) == expected
    assert result["values"]["recovered"] is True
    assert result["values"]["error"] == {"message": "boom", "type": "RuntimeError"}


def test_langgraph_native_fork_join_compete_is_deterministic(tmp_path: Path) -> None:
    """COMPILE-004: compete mode resolves to the first declared branch."""
    workflow_path = tmp_path / "fork-compete.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: fork-compete
  version: '1.0.0'
do:
  - parallel:
      fork:
        compete: true
        branches:
          - left:
              set:
                left: true
          - right:
              set:
                right: true
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"message": "hello"}

    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-fork-compete"}))

    # Compete mode deterministically resolves to the first declared branch:
    # LangGraph has no first-completion cancellation, so the declared order
    # stands in for completion order (documented divergence from the
    # interpreter's first-completed semantics).
    assert result["output"] == {"left": True}
    assert result["values"]["parallel"][0] == {"left": True}
    """COMPILE-004: an if-gated fork skips branch execution like the interpreter."""
    workflow_path = tmp_path / "fork-gated.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: fork-gated
  version: '1.0.0'
do:
  - parallel:
      if: false
      fork:
        branches:
          - left:
              set:
                left: true
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"message": "hello"}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-fork-gated"}))

    assert _engine_output(result) == expected
    assert "left" not in result["output"]


def test_langgraph_native_fork_nested_in_switch_matches_interpreter(tmp_path: Path) -> None:
    """COMPILE-004: a fork inside a switch branch keeps interpreter parity."""
    workflow_path = tmp_path / "fork-in-switch.yaml"
    workflow_path.write_text(
        """\
document:
  dsl: '1.0.3'
  namespace: conformance.support
  name: fork-in-switch
  version: '1.0.0'
do:
  - route:
      case: '${ .mode }'
      switch:
        - name: fast
          then:
            - parallel:
                fork:
                  branches:
                    - left:
                        set:
                          left: true
                    - right:
                        set:
                          right: true
""",
        encoding="utf-8",
    )
    application = load_application(root=tmp_path, workflow_path=workflow_path)
    workflow = application.workflows[0]
    graph = compile_workflow(application, workflow.id)
    payload = {"mode": "fast"}

    expected = asyncio.run(InMemoryEngine(application).invoke(workflow.id, payload))
    result = asyncio.run(graph.ainvoke({"payload": payload, "run_id": "parity-fork-switch"}))

    assert _engine_output(result) == expected
    # A fork nested in a switch branch sets output to the branch-values list.
    branches = result["output"]
    assert branches[0]["left"] is True
    assert branches[1]["right"] is True


def test_adk_compiler_builds_agent_without_network_call() -> None:
    application = load_application(ROOT / "examples" / "application")
    agent = compile_agent(application)

    assert agent.name == "support_agent"


def test_adk_native_web_ui_is_exposed() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_adk_app(application=application))

    assert client.get("/dev-ui").status_code == 200
    assert client.get("/list-apps").json() == ["support_agent"]


def test_adk_chat_completions_unknown_model_uses_structured_error_envelope() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_adk_app(application=application))

    response = client.post(
        "/v1/chat/completions",
        json={"model": "unknown/model@1", "messages": [{"role": "user", "content": "hi"}]},
    )

    assert response.status_code == 404
    assert response.json()["error"]["type"] == "invalid_request_error"


def test_adk_request_limit_rejects_oversized_body_without_content_length(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("MAX_REQUEST_BYTES", "128")
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_adk_app(application=application))

    def chunks() -> Any:
        yield b"{" + b"x" * 200 + b"}"

    response = client.post("/v1/events", content=chunks())

    assert "content-length" not in {key.lower() for key in response.request.headers.keys()}
    assert response.status_code == 413


def test_adk_health_ready_reports_unavailable_checkpoint_store(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    application = load_application(ROOT / "examples" / "application")
    store = SQLiteCheckpointStore(tmp_path / "checkpoints.db")

    async def _broken_ping() -> None:
        raise RuntimeError("disk unavailable")

    monkeypatch.setattr(store, "ping", _broken_ping)
    engine = InMemoryEngine(application, checkpoint_store=store)
    client = TestClient(create_adk_app(application=application, engine=engine))

    response = client.get("/health/ready")

    assert response.status_code == 503
    assert response.json()["status"] == "not_ready"


def test_adk_cors_is_disabled_by_default() -> None:
