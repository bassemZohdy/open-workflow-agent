ROOT = Path(__file__).parents[1]


@pytest.mark.asyncio
async def test_in_memory_engine_executes_bound_agent() -> None:
    application = load_application(ROOT / "examples" / "application")
    engine = InMemoryEngine(application)

    result = await engine.invoke(
        "support",
        {"request": "Where is my order?"},
        messages=[{"role": "user", "content": "Where is my order?"}],
    )

    assert "support-agent" in result["content"]


def test_openai_compatible_routes() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    models = client.get("/v1/models")
    assert models.status_code == 200
    assert any(item["id"] == "support" for item in models.json()["data"]) is False

    response = client.post(
        "/v1/chat/completions",
        json={
            "model": "example.support/support-workflow@1.0.0",
            "messages": [{"role": "user", "content": "Where is my order?"}],
        },
    )
    assert response.status_code == 200
    assert response.json()["object"] == "chat.completion"


def test_chat_completions_accepts_but_ignores_openai_only_fields() -> None:
    # temperature/tools/n are accepted for OpenAI SDK compatibility but have
    # no effect: model config comes from the Agent Spec, tool bindings from
    # bindings.yaml. Documented in README's "Using the HTTP API" section.
    application = load_application(ROOT / "examples" / "application")
    engine = InMemoryEngine(application)
    plain = TestClient(create_app(application=application, engine=engine)).post(
        "/v1/chat/completions",
        json={
            "model": "example.support/support-workflow@1.0.0",
            "messages": [{"role": "user", "content": "Where is my order?"}],
        },
    )
    with_openai_fields = TestClient(create_app(application=application, engine=engine)).post(
        "/v1/chat/completions",
        json={
            "model": "example.support/support-workflow@1.0.0",
            "messages": [{"role": "user", "content": "Where is my order?"}],
            "temperature": 1.9,
            "n": 3,
            "tools": [
                {
                    "type": "function",
                    "function": {"name": "unrelated_tool", "parameters": {"type": "object"}},
                }
            ],
        },
    )

    assert plain.status_code == with_openai_fields.status_code == 200
    assert (
        plain.json()["choices"][0]["message"]["content"]
        == with_openai_fields.json()["choices"][0]["message"]["content"]
    )


def test_openai_streaming_route() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))
    response = client.post(
        "/v1/chat/completions",
        json={
            "model": "example.support/support-workflow@1.0.0",
            "stream": True,
            "messages": [{"role": "user", "content": "hello"}],
        },
    )
    assert response.status_code == 200
    lines = [line for line in response.text.splitlines() if line.startswith("data: ")]
    assert len(lines) >= 3
    assert lines[-1] == "data: [DONE]"
    for line in lines[:-1]:
        payload = json.loads(line.removeprefix("data: "))
        assert payload["object"] == "chat.completion.chunk"
        assert payload["choices"][0]["delta"] is not None


@pytest.mark.asyncio
async def test_in_memory_engine_stream_yields_intermediate_events(tmp_path: Path) -> None:
    workflow = tmp_path / "workflow.yaml"
    workflow.write_text(
        "document:\n"
        "  dsl: '1.0.3'\n"
        "  namespace: x\n"
        "  name: streamed\n"
        "  version: '1'\n"
        "do:\n"
        "  - first:\n"
        "      set:\n"
        "        value: 1\n"
        "  - second:\n"
        "      set:\n"
        "        value: 2\n",
        encoding="utf-8",
    )
    application = load_application(tmp_path)
    events = [
        event
        async for event in InMemoryEngine(application).stream("x/streamed@1", {"input": "hello"})
    ]
    kinds = [event.kind for event in events]
    assert "task.completed" in kinds
    assert kinds[-1] == "completed"
    assert events[-1].data.get("value") == 2


def test_health_ready_is_ok_without_a_checkpoint_store() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    response = client.get("/health/ready")

    assert response.status_code == 200
    assert response.json() == {"status": "ready"}


def test_health_ready_checks_checkpoint_store_connectivity(tmp_path: Path) -> None:
    application = load_application(ROOT / "examples" / "application")
    store = SQLiteCheckpointStore(tmp_path / "checkpoints.db")
    engine = InMemoryEngine(application, checkpoint_store=store)
    client = TestClient(create_app(application=application, engine=engine))

    response = client.get("/health/ready")

    assert response.status_code == 200


def test_health_ready_reports_unavailable_checkpoint_store(
    tmp_path: Path, caplog: pytest.LogCaptureFixture
) -> None:
    application = load_application(ROOT / "examples" / "application")
    store = SQLiteCheckpointStore(tmp_path / "checkpoints.db")

    async def _broken_ping() -> None:
        raise RuntimeError("disk unavailable")

    store.ping = _broken_ping  # type: ignore[method-assign]
    engine = InMemoryEngine(application, checkpoint_store=store)
    client = TestClient(create_app(application=application, engine=engine))

    with caplog.at_level("ERROR"):
        response = client.get("/health/ready")

    assert response.status_code == 503
    assert response.json()["status"] == "not_ready"
    assert any("readiness check failed" in record.getMessage() for record in caplog.records)


