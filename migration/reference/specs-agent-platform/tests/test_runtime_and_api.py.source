@pytest.mark.asyncio
async def test_langgraph_agent_executes_bound_mcp_tool(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("OPENAI_API_KEY", "test")
    from langchain_core.messages import AIMessage

    class FakeChat:
        calls = 0

        def __init__(self, **kwargs: object) -> None:
            del kwargs

        def bind_tools(self, tools: list[dict[str, Any]]) -> "FakeChat":
            assert tools[0]["function"]["name"] == "lookup"
            return self

        async def ainvoke(self, messages: list[object]) -> AIMessage:
            del messages
            self.calls += 1
            if self.calls == 1:
                return AIMessage(
                    content="",
                    tool_calls=[
                        {
                            "name": "lookup",
                            "args": {"order_id": "A-42"},
                            "id": "call-1",
                            "type": "tool_call",
                        }
                    ],
                )
            return AIMessage(content="Order A-42 is shipped.")

    class FakeRegistry(McpToolRegistry):
        def __init__(self) -> None:
            super().__init__({"lookup": {}})

        async def call(self, binding_name: str, arguments: dict[str, Any]) -> dict[str, Any]:
            assert binding_name == "lookup"
            return {"status": "shipped", "order_id": arguments["order_id"]}

    monkeypatch.setattr("langchain_openai.ChatOpenAI", FakeChat)
    agent = AgentIR(
        id="support-agent",
        name="support-agent",
        component_type="Agent",
        source="test",
        document={"llm_config": {"model_id": "test"}},
        tools=(
            {
                "name": "lookup",
                "binding": "lookup",
                "description": "Look up an order.",
                "parameters": {
                    "type": "object",
                    "properties": {"order_id": {"type": "string"}},
                    "required": ["order_id"],
                },
            },
        ),
    )
    result = await LangGraphAgentInvoker(FakeRegistry()).invoke(
        agent,
        [{"role": "user", "content": "Where is A-42?"}],
        RuntimeContext({}),
    )

    assert result == {"content": "Order A-42 is shipped."}


def test_events_route_prefers_cloudevents_headers_over_body() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    response = client.post(
        "/v1/events",
        headers={"ce-id": "header-id", "ce-type": "header.type"},
        json={"id": "body-id", "type": "body.type"},
    )

    assert response.status_code == 202
    body = response.json()
    assert body == {"accepted": True, "event_id": "header-id", "event_type": "header.type"}


def test_events_route_falls_back_to_body_when_headers_absent() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    response = client.post("/v1/events", json={"id": "body-id", "type": "body.type"})

    assert response.status_code == 202
    body = response.json()
    assert body == {"accepted": True, "event_id": "body-id", "event_type": "body.type"}


def test_events_route_accepts_empty_body() -> None:
