def test_api_key_and_request_limit(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("OPEN_AGENT_API_KEY", "secret")
    monkeypatch.setenv("MAX_REQUEST_BYTES", "128")
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    assert client.get("/v1/models").status_code == 401
    authorized = client.get("/v1/models", headers={"Authorization": "Bearer secret"})
    assert authorized.status_code == 200
    oversized = client.post(
        "/v1/events",
        headers={"X-API-Key": "secret"},
        content=b"{" + b"x" * 200 + b"}",
    )
    assert oversized.status_code == 413


def test_request_limit_rejects_oversized_body_without_content_length(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("MAX_REQUEST_BYTES", "128")
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    def chunks() -> Any:
        yield b"{" + b"x" * 200 + b"}"

    oversized = client.post("/v1/events", content=chunks())

    assert "content-length" not in {key.lower() for key in oversized.request.headers.keys()}
    assert oversized.status_code == 413


def test_invocation_timeout(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("REQUEST_TIMEOUT_SECONDS", "0.01")
    application = load_application(ROOT / "examples" / "application")

    class SlowEngine:
        async def invoke(self, *args: object, **kwargs: object) -> dict[str, Any]:
            del args, kwargs
            await asyncio.sleep(0.05)
            return {"content": "late"}

        async def stream(self, *args: object, **kwargs: object) -> AsyncIterator[ExecutionEvent]:
            del args, kwargs
            return
            yield

        async def execute_task(self, *args: object, **kwargs: object) -> dict[str, Any]:
            del args, kwargs
            return {"content": "late"}

    client = TestClient(create_app(application=application, engine=SlowEngine()))
    response = client.post(
        "/v1/chat/completions",
        json={
            "model": "example.support/support-workflow@1.0.0",
            "messages": [{"role": "user", "content": "hello"}],
        },
    )

    assert response.status_code == 504


def test_runtime_errors_use_consistent_envelope() -> None:
    application = load_application(ROOT / "examples" / "application")

    class FailingEngine:
        async def invoke(self, *args: object, **kwargs: object) -> dict[str, Any]:
            del args, kwargs
            raise RuntimeError("boom")

        async def stream(self, *args: object, **kwargs: object) -> AsyncIterator[ExecutionEvent]:
            del args, kwargs
            raise RuntimeError("boom")
            yield

        async def execute_task(self, *args: object, **kwargs: object) -> dict[str, Any]:
            del args, kwargs
            raise RuntimeError("boom")

    client = TestClient(create_app(application=application, engine=FailingEngine()))
    response = client.post(
        "/v1/chat/completions",
        json={
            "model": "example.support/support-workflow@1.0.0",
            "messages": [{"role": "user", "content": "hello"}],
        },
    )

    assert response.status_code == 500
    assert response.json()["error"]["type"] == "server_error"


def test_runtime_errors_are_logged_server_side(
    monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    # /v1/chat/completions has its own try/except that turns failures into an
    # HTTPException before they ever reach the app-wide handler, so exercise a
    # route (/v1/models) with no local guard to hit the generic handler.
    def _boom(self: object, identifier: str) -> str:
        del self, identifier
        raise RuntimeError("boom")

    monkeypatch.setattr("open_agent_core.ir.ApplicationIR.resolve_entrypoint", _boom)
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(
        create_app(application=application, engine=InMemoryEngine(application)),
        raise_server_exceptions=False,
    )

    with caplog.at_level("ERROR"):
        response = client.get("/v1/models")

    assert response.status_code == 500
    assert any("unhandled error" in record.getMessage() for record in caplog.records)
    assert any(record.exc_info for record in caplog.records)


def test_cors_is_disabled_by_default() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    response = client.get("/v1/models", headers={"Origin": "https://example.com"})

    assert "access-control-allow-origin" not in response.headers


def test_cors_allows_configured_origin(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("CORS_ALLOW_ORIGINS", "https://example.com")
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    allowed = client.get("/v1/models", headers={"Origin": "https://example.com"})
    denied = client.get("/v1/models", headers={"Origin": "https://not-allowed.example"})

    assert allowed.headers["access-control-allow-origin"] == "https://example.com"
    assert "access-control-allow-origin" not in denied.headers


def test_get_model_by_id() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    response = client.get("/v1/models/example.support/support-workflow@1.0.0")
    assert response.status_code == 200
    body = response.json()
    assert body["id"] == "example.support/support-workflow@1.0.0"
    assert body["object"] == "model"

    unknown = client.get("/v1/models/unknown/model@1")
    assert unknown.status_code == 404
    assert unknown.json()["error"]["type"] == "invalid_request_error"


def test_models_pagination() -> None:
    application = load_application(ROOT / "examples" / "application")
    client = TestClient(create_app(application=application, engine=InMemoryEngine(application)))

    response = client.get("/v1/models?limit=1")
    assert response.status_code == 200
    body = response.json()
    assert len(body["data"]) == 1
    assert body["has_more"] is True
    assert body["first_id"] == body["data"][0]["id"]
    assert body["last_id"] == body["data"][0]["id"]

    next_page = client.get(f"/v1/models?limit=1&after={body['last_id']}")
    assert next_page.status_code == 200
    next_body = next_page.json()
    assert len(next_body["data"]) == 1
    assert next_body["data"][0]["id"] != body["data"][0]["id"]
    assert next_body["has_more"] is False


def test_tools_pagination() -> None:
