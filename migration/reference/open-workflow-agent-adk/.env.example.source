# OpenWorkflow-ADK environment variables.
# Copy to `.env` (gitignored) and fill in local values.
# Precedence (highest wins): env > per-task agent config > project defaults.
# Convention: WORKFLOW_ prefix, __ as nesting separator (lowercased).
# See docs/reference/configuration.md for the full reference.

# --- Agent defaults (applied to every task with no per-task agent config) ---
WORKFLOW_AGENT__MODEL=gemini-2.0-flash
# WORKFLOW_AGENT__INSTRUCTION=You are a helpful workflow agent.

# --- Named model bundles (document.metadata.adk.models) — repoint centrally ---
# WORKFLOW_MODELS__FAST__MODEL=gemini-2.0-flash
# WORKFLOW_MODELS__POWERFUL__MODEL=gemini-2.5-pro

# --- Providers (document.metadata.adk.providers) — credentials & endpoints ---
# WORKFLOW_PROVIDERS__OPENAI_PROD__API_KEY=sk-...
# WORKFLOW_PROVIDERS__OPENAI_PROD__BASE_URL=https://api.openai.com/v1

# --- Memory backends (document.metadata.adk.memories) ---
# WORKFLOW_MEMORIES__DEFAULT__TYPE=redis          # in-memory|file|redis|postgres|vertex
# WORKFLOW_MEMORIES__DEFAULT__URL=redis://localhost:6379/0

# --- Secrets (use.secrets references resolve through these) ---
# WORKFLOW_SECRET__OPENAI_KEY=...

# --- Session / state backend ---
WORKFLOW_SESSION_BACKEND=in-memory               # in-memory|database|vertex
# WORKFLOW_SESSION_DATABASE_URL=postgresql+psycopg://user:pass@host/db

# --- Durability & resume ---
# WORKFLOW_CHECKPOINT_INTERVAL=10                 # checkpoint every N tasks
# WORKFLOW_SUSPEND_WAIT_SECONDS=30                # poll interval for suspended waits

# --- Security: egress & expression safety ---
# WORKFLOW_EGRESS_ALLOWLIST=10.0.0.0/8,localhost  # SSRF allowlist for call/http + schema fetch
# WORKFLOW_EXPRESSION_MAX_DEPTH=50
# WORKFLOW_EXPRESSION_MAX_LENGTH=100000
# WORKFLOW_EXPRESSION_TIMEOUT_SECONDS=0.25

# --- Deployment modes ---
# WORKFLOW_AIRGAPPED=0                            # 1 blocks all remote resources
# WORKFLOW_VERTEX_AGENT_ENGINE_ID=...             # Vertex AI Agent Engine (prod)

# --- C24 hardening: egress (fail-closed SSRF guard) ---
# Hostnames are resolved and blocked by default. Allow exact trusted hosts here.
# WORKFLOW_EGRESS_ALLOWLIST=internal-api.example
# WORKFLOW_EGRESS_ALLOW_UNRESOLVED=0      # 1 lets unresolvable hostnames through
# WORKFLOW_EGRESS_SKIP_DNS=0              # 1 = legacy pass-through (test doubles only)

# --- C24 hardening: containers (deny-all by default) ---
# WORKFLOW_CONTAINER_VOLUME_ALLOWLIST=/data       # host roots that may be mounted
# WORKFLOW_CONTAINER_NETWORK_ALLOWLIST=bridge     # network modes a container may request
# WORKFLOW_CONTAINER_PORTS_ALLOWED=0              # 1 enables host port publishing
# WORKFLOW_CONTAINER_CPU_LIMIT=0.5
# WORKFLOW_CONTAINER_MEMORY_LIMIT=256m
# WORKFLOW_CONTAINER_PIDS_LIMIT=128

# --- C24 hardening: MCP stdio servers ---
# WORKFLOW_MCP_COMMAND_ALLOWLIST=node,python3     # allowed server commands
# WORKFLOW_MCP_ALLOW_UNLISTED=0
# WORKFLOW_MCP_TIMEOUT_SECONDS=60

# --- C24 hardening: bounded consumers & local resource reads ---
# WORKFLOW_CONSUME_TIMEOUT_SECONDS=3600
# WORKFLOW_RESOURCE_BASE_DIR=.                    # base dir for call-task local reads

# --- C24 hardening: HTTP server auth (required for non-loopback binds) ---
# WORKFLOW_SERVER_API_KEY=change-me
