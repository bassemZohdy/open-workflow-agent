document:
  dsl: '1.0.3'
  namespace: examples
  name: rag
  version: '1.0.0'
do:
  - retrieve:
      call: http
      with:
        method: get
        endpoint: https://retriever.example/search
        query:
          q: '${ .question }'
  - answer:
      wait:
        seconds: 0
      metadata:
        adk:
          agent:
            model: gemini-2.5-flash
            instruction: Answer the question using the retrieved context.
