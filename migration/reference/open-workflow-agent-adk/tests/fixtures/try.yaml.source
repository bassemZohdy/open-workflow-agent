document:
  dsl: '1.0.3'
  namespace: fixtures
  name: try
  version: '1.0.0'
do:
  - guarded:
      try:
        - fail:
            raise:
              error:
                type: https://example.test/failure
                status: 500
                title: Failure
      catch:
        as: failure
        do:
          - recover:
              set:
                recovered: '"yes"'
