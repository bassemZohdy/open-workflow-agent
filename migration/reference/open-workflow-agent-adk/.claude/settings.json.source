{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | tr -d '\\r' | { read -r f; case \"$f\" in *.py) uvx ruff format \"$f\" 2>/dev/null && uvx ruff check --fix \"$f\" 2>/dev/null;; esac; } || true"
          }
        ]
      }
    ]
  }
}
