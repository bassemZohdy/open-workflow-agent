FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml uv.lock* README.md ./
COPY core ./core
COPY engines/adk ./engines/adk
COPY resources ./resources
COPY runtime-catalog ./runtime-catalog

RUN pip install --no-cache-dir .
ENV PYTHONPATH=/app/core/src:/app/engines/adk/src
EXPOSE 8080
USER 10001
CMD ["uvicorn", "open_workflow_agent_adk.server:app", "--host", "0.0.0.0", "--port", "8080"]
