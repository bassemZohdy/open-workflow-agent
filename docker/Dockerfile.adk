# syntax=docker/dockerfile:1

ARG PYTHON_IMAGE=python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17
FROM ${PYTHON_IMAGE} AS builder

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=0 \
    UV_CACHE_DIR=/tmp/uv-cache \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /build

# Install the locked third-party dependency graph before copying application
# source so normal code changes can reuse the expensive dependency layer.
# Package metadata (readme/license) files are required by the wheel builds.
COPY pyproject.toml README.md LICENSE ./
COPY engines/adk/pyproject.toml engines/adk/uv.lock engines/adk/README.md ./engines/adk/
RUN pip install --no-cache-dir "uv==0.11.26" \
    && uv sync --directory /build/engines/adk --locked --no-dev --no-editable \
       --extra native --extra knowledge --extra model --extra postgres \
       --no-install-project --no-install-package open-workflow-agent

COPY core ./core
COPY engines/adk/src ./engines/adk/src
COPY resources ./resources
COPY runtime-catalog ./runtime-catalog
RUN uv sync --directory /build/engines/adk --locked --no-dev --no-editable \
       --extra native --extra knowledge --extra model --extra postgres \
    && /opt/venv/bin/python -c "import litellm; from open_workflow_agent.catalog import LiteLLMModel" \
    && /opt/venv/bin/uvicorn --version \
    && rm -rf /tmp/uv-cache /root/.cache

RUN mkdir -p /build/opt/models \
    && FASTEMBED_CACHE_PATH=/build/opt/models \
       /opt/venv/bin/python -c "from fastembed import TextEmbedding; model = TextEmbedding(model_name='sentence-transformers/all-MiniLM-L6-v2', cache_dir='/build/opt/models'); next(iter(model.embed(['warmup'])))" \
    && find /opt/venv -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /opt/venv -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

FROM ${PYTHON_IMAGE} AS runtime

ARG OWA_VERSION=0.1.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="open-workflow-agent-adk" \
      org.opencontainers.image.version="$OWA_VERSION" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.source="https://github.com/bassemZohdy/open-workflow-agent"

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    FASTEMBED_CACHE_PATH=/tmp/fastembed \
    HF_HUB_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# The environment is created at its final path in the builder so console-script
# shebangs remain valid after the multi-stage copy.
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/opt/models /opt/models
COPY docker/entrypoint.sh /usr/local/bin/owa-entrypoint

RUN install -d -o 10001 -g 0 -m 0770 /config /knowledge /data \
    && chmod 0555 /usr/local/bin/owa-entrypoint \
    && chmod -R a+rX /opt/models

EXPOSE 8080
STOPSIGNAL SIGTERM
# Readiness probe for plain Docker runs; orchestrators typically override it
# with their own HTTP probe against the same endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD python -c "import os,sys,urllib.request; port=os.environ.get('OWA__SERVER__PORT','8080'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{port}/health/ready',timeout=4).status==200 else 1)"
USER 10001:0
ENTRYPOINT ["/usr/local/bin/owa-entrypoint"]
CMD ["python", "-m", "open_workflow_agent_adk.server"]
