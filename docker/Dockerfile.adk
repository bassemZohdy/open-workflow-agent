FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml uv.lock* README.md ./
COPY core ./core
COPY engines/adk ./engines/adk
COPY resources ./resources
COPY runtime-catalog ./runtime-catalog

RUN pip install --no-cache-dir "uv==0.11.26" \
    && uv sync --directory /app/engines/adk --locked --no-dev --extra native --extra knowledge
ENV PATH=/app/engines/adk/.venv/bin:$PATH
ENV SENTENCE_TRANSFORMERS_HOME=/opt/models
RUN install -d -o 10001 -g 0 -m 0770 /config /knowledge /data /opt/models \
    && python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2', revision='ea78891063587eb050ed4166b20062eaf978037c', device='cpu', cache_folder='/opt/models')"
EXPOSE 8080
USER 10001:0
CMD ["python", "-m", "open_workflow_agent_adk.server"]
