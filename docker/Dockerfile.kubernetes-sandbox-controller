FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17 AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY kubernetes-sandbox-controller /build/controller
COPY LICENSE /build/LICENSE
RUN python -m pip wheel --wheel-dir /wheels /build/controller

FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin controller
COPY --from=build /wheels /wheels
RUN python -m pip install --no-index --find-links /wheels open-workflow-agent-kubernetes-sandbox-controller \
    && rm -rf /wheels
USER 65532:65532
EXPOSE 8090
CMD ["uvicorn", "open_workflow_agent_kubernetes_sandbox_controller.app:create_default_app", "--factory", "--host", "127.0.0.1", "--port", "8090"]
