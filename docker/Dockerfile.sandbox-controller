FROM docker:29.7.2-cli@sha256:3f4743208d2338c934d7b8bcfbe1bb54c0b2355c510ad5e0f31c0c4a54bd704e

# Security upgrade at build time: the pinned base image ships Alpine packages
# (openssl, libexpat) that the Alpine security team has since fixed. Upgrading
# here keeps the runtime image free of known CRITICAL/HIGH OS-package CVEs
# without waiting for a base-image rebuild. The controller installs nothing at
# runtime, so this does not violate the no-runtime-install boundary.
RUN apk upgrade --no-cache \
    && apk add --no-cache python3 py3-pip \
    && python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY sandbox-controller /app/sandbox-controller
COPY LICENSE /app/LICENSE
RUN pip install --no-cache-dir /app/sandbox-controller \
    # Remove the package managers and ensurepip seeds after installation: the
    # controller installs nothing at runtime, and pip's vendored msgpack and
    # pkg_resources copies would otherwise persist as permanent scanned
    # attack surface that only a pip release can fix.
    && pip uninstall -y pip \
    && /usr/bin/python3 -m pip uninstall --break-system-packages -y pip \
    && rm -rf /usr/lib/python3*/ensurepip /opt/venv/lib/python3*/ensurepip \
    && mkdir -p /run/owa-sandbox \
    && chown 65532:0 /run/owa-sandbox \
    && chmod 0770 /run/owa-sandbox

USER 65532:0

ENTRYPOINT ["/bin/sh", "-c", "umask 0002; exec uvicorn open_workflow_agent_sandbox_controller.app:app --uds /run/owa-sandbox/controller.sock"]
