FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml uv.lock* README.md ./
COPY core ./core
COPY engines/langgraph ./engines/langgraph
COPY resources ./resources
COPY runtime-catalog ./runtime-catalog

RUN pip install --no-cache-dir .
ENV PYTHONPATH=/app/core/src:/app/engines/langgraph/src
EXPOSE 8080
USER 10001
CMD ["uvicorn", "open_workflow_agent_langgraph.server:app", "--host", "0.0.0.0", "--port", "8080"]
