FROM python:3.12-slim AS builder

ENV UV_CACHE_DIR=/tmp/uv-cache \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /build

COPY pyproject.toml uv.lock README.md ./
COPY core ./core
COPY engines/langgraph ./engines/langgraph
COPY resources ./resources
COPY runtime-catalog ./runtime-catalog

RUN pip install --no-cache-dir "uv==0.11.26" \
    && uv sync --directory /build/engines/langgraph --locked --no-dev --no-editable --extra sqlite --extra knowledge \
    && rm -rf /tmp/uv-cache /root/.cache

RUN mkdir -p /build/opt/models \
    && FASTEMBED_CACHE_PATH=/build/opt/models \
       /build/engines/langgraph/.venv/bin/python -c "from fastembed import TextEmbedding; model = TextEmbedding(model_name='sentence-transformers/all-MiniLM-L6-v2', cache_dir='/build/opt/models'); next(iter(model.embed(['warmup'])))" \
    && find /build -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /build -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

FROM python:3.12-slim AS runtime

ENV PATH=/opt/venv/bin:$PATH \
    FASTEMBED_CACHE_PATH=/opt/models \
    HF_HUB_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY --from=builder /build/engines/langgraph/.venv /opt/venv
COPY --from=builder /build/opt/models /opt/models

RUN install -d -o 10001 -g 0 -m 0770 /config /knowledge /data \
    && find /opt/venv -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /opt/venv -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

EXPOSE 8080
USER 10001:0
CMD ["python", "-m", "open_workflow_agent_langgraph.server"]
