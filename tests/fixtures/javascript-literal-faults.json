[
  {
    "id": "literal-inline-error",
    "tasks": [{"fail": {"raise": {"error": {"status": 400, "type": "https://errors.test/compliance", "title": "Compliance Error"}}}}],
    "expected": {"code": "workflow_execution_error", "message": "Compliance Error", "details": {"status": 400, "type": "https://errors.test/compliance", "title": "Compliance Error", "instance": "/do/0/fail"}}
  },
  {
    "id": "literal-detail-precedence",
    "tasks": [{"fail": {"raise": {"error": {"status": 409, "type": "https://errors.test/conflict", "title": "Conflict", "detail": "Declared conflict", "instance": "/caller/instance"}}}}],
    "expected": {"code": "workflow_execution_error", "message": "Declared conflict", "details": {"status": 409, "type": "https://errors.test/conflict", "title": "Conflict", "detail": "Declared conflict", "instance": "/do/0/fail"}}
  },
  {
    "id": "literal-nested-fault",
    "tasks": [{"outer": {"do": [{"first": {"set": {"intermediate": true}}}, {"inner": {"raise": {"error": {"status": 400, "type": "https://errors.test/nested"}}}}]}}, {"unreachable": {"set": {"wrong": true}}}],
    "expected": {"code": "workflow_execution_error", "message": "https://errors.test/nested", "details": {"status": 400, "type": "https://errors.test/nested", "instance": "/do/0/outer/do/1/inner"}}
  },
  {
    "id": "literal-escaped-fault-reference",
    "tasks": [{"slash/tilde~": {"raise": {"error": {"status": 422, "type": "https://errors.test/escaped", "title": "Invalid"}}}}],
    "expected": {"code": "workflow_execution_error", "message": "Invalid", "details": {"status": 422, "type": "https://errors.test/escaped", "title": "Invalid", "instance": "/do/0/slash~1tilde~0"}}
  },
  {
    "id": "catch-filter-mismatch-propagates",
    "tasks": [{"guard": {"try": [{"fail": {"raise": {"error": {"status": 400, "type": "https://errors.test/a"}}}}], "catch": {"errors": {"with": {"status": 500}}, "do": [{"recover": {"set": {"wrong": true}}}]}}}],
    "expected": {"code": "workflow_execution_error", "message": "https://errors.test/a", "details": {"instance": "/do/0/guard/try/0/fail", "status": 400, "type": "https://errors.test/a"}}
  },
  {
    "id": "catch-handler-fault",
    "tasks": [{"guard": {"try": [{"fail": {"raise": {"error": {"status": 400, "type": "https://errors.test/a"}}}}], "catch": {"do": [{"fail2": {"raise": {"error": {"status": 500, "type": "https://errors.test/b"}}}}]}}}],
    "expected": {"code": "workflow_execution_error", "message": "https://errors.test/b", "details": {"instance": "/do/0/guard/catch/do/0/fail2", "status": 500, "type": "https://errors.test/b"}}
  },
  {
    "id": "catch-every-filter-must-match",
    "tasks": [{"guard": {"try": [{"fail": {"raise": {"error": {"status": 422, "type": "https://errors.test/z", "title": "Z"}}}}], "catch": {"errors": {"with": {"status": 422, "title": "other"}}, "do": [{"r": {"set": {"m": "wrong"}}}]}}}],
    "expected": {"code": "workflow_execution_error", "message": "Z", "details": {"instance": "/do/0/guard/try/0/fail", "status": 422, "title": "Z", "type": "https://errors.test/z"}}
  },
  {
    "id": "fork-branch-fault-propagates",
    "tasks": [{"par": {"fork": {"branches": [{"a": {"set": {"v": "A"}}}, {"b": {"raise": {"error": {"status": 400, "type": "https://errors.test/a"}}}}]}}}],
    "expected": {"code": "workflow_execution_error", "message": "https://errors.test/a", "details": {"instance": "/do/0/par/fork/branches/1/b", "status": 400, "type": "https://errors.test/a"}}
  },
  {
    "id": "expr-fault-runtime-division",
    "tasks": [{"a": {"set": "${ 1 / 0 }"}}],
    "expected": {"code": "expression_error", "message": "jq expression evaluation failed", "details": {"instance": "/do/0/a"}}
  },
  {
    "id": "expr-fault-two-values",
    "tasks": [{"a": {"set": "${ 1, 2 }"}}],
    "expected": {"code": "expression_error", "message": "jq expression must produce exactly one JSON value", "details": {"instance": "/do/0/a"}}
  },
  {
    "id": "expr-fault-no-value",
    "tasks": [{"a": {"set": "${ empty }"}}],
    "expected": {"code": "expression_error", "message": "jq expression must produce exactly one JSON value", "details": {"instance": "/do/0/a"}}
  },
  {
    "id": "expr-fault-env-disabled",
    "tasks": [{"a": {"set": "${ env }"}}],
    "expected": {"code": "expression_error", "message": "jq expression evaluation failed", "details": {"instance": "/do/0/a"}}
  },
  {
    "id": "expr-fault-input-disabled",
