    "expected": {"code": "expression_error", "message": "jq expression evaluation failed", "details": {"instance": "/do/0/a"}}
  },
  {
    "id": "expr-fault-non-finite",
    "tasks": [{"a": {"set": "${ [nan] | .[0] }"}}],
    "expected": {"code": "expression_error", "message": "jq expression evaluation failed", "details": {"instance": "/do/0/a"}}
  },
  {
    "id": "expr-fault-unsafe-integer",
